# Firebase client config (Project settings > General > Your apps).
EXPO_PUBLIC_FIREBASE_APIKEY=
EXPO_PUBLIC_FIREBASE_AUTHDOMAIN=
# Use the regional RTDB URL from Firebase (e.g. *.europe-west1.firebasedatabase.app)
EXPO_PUBLIC_FIREBASE_DATABASE_URL=
EXPO_PUBLIC_FIREBASE_PROJECTID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGINSENDERID=
EXPO_PUBLIC_FIREBASE_GOOGLE_APP_ID=
EXPO_PUBLIC_FIREBASE_BUNDLE_ID=

# Android native config (optional; used by native builds).
EXPO_PUBLIC_FIREBASE_ANDROID_API_KEY=
EXPO_PUBLIC_FIREBASE_ANDROID_MOBILE_SDK_APP_ID=
EXPO_PUBLIC_FIREBASE_ANDROID_PACKAGE_NAME=

# Firebase Admin (scripts/sync-feature-requests-to-backlog.ts only — never ship this in the app).
# Create a service account in Firebase console > Project settings > Service accounts.
# FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json
# Or paste the JSON in one line:
# FIREBASE_SERVICE_ACCOUNT_JSON=
